{
  "manifest_version": 3,
  "name": "Dashboard · Football ANF",
  "version": "1.0.0",
  "description": "Lecture locale des résultats publics du FC Le Locle Juniors A pour le dashboard.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://matchcenter-anf.football.ch/*"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "Football ANF · résultats locaux",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none';"
  },
  "externally_connectable": {
    "matches": [
      "https://soaresbm1.github.io/dashboard-personnel/*"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://matchcenter-anf.football.ch/default.aspx*"
      ],
      "js": [
        "reader-core.js",
        "source.js"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "match_about_blank": false,
      "match_origin_as_fallback": false,
      "world": "ISOLATED"
    }
  ]
}
